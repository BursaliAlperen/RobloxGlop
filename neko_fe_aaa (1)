local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")
local playerGui = player:WaitForChild("PlayerGui")

-- ============================================================
-- CONSTANTS & SETTINGS
-- ============================================================
local THEMES = {
    Pink = Color3.fromRGB(255, 105, 180),
    Purple = Color3.fromRGB(176, 90, 255),
    White = Color3.fromRGB(255, 255, 255)
}
local ACCENT_COLOR = THEMES.Pink
local MANGA_BG = Color3.fromRGB(255, 255, 255)
local KEY_SYSTEM_ENABLED = false -- Şu anlık kapalı
local CORRECT_KEY = "NEKO_AAA_2024"
local LATCH_DISTANCE = 3.5
local FOLLOW_SPEED = 18

local rng = Random.new()
local CF, ANGLES, RAD = CFrame.new, CFrame.Angles, math.rad
local function Clerp(a, b, t) return a:Lerp(b, t) end

-- ============================================================
-- PROCEDURAL ANIMATION ENGINE (R6)
-- ============================================================
local Anim = {
    Sine = 0,
    State = "Idle", -- Idle, Move, Kneel, Latch
    Motors = {},
    BaseC0 = {}
}

local function setupMotors()
    Anim.Motors = {
        root = root:FindFirstChild("RootJoint"),
        waist = character:FindFirstChild("Torso"):FindFirstChild("Neck"),
        rightShoulder = character:FindFirstChild("Torso"):FindFirstChild("Right Shoulder"),
        leftShoulder = character:FindFirstChild("Torso"):FindFirstChild("Left Shoulder"),
        rightHip = character:FindFirstChild("Torso"):FindFirstChild("Right Hip"),
        leftHip = character:FindFirstChild("Torso"):FindFirstChild("Left Hip")
    }
    for k, v in pairs(Anim.Motors) do
        if v then Anim.BaseC0[k] = v.C0 end
    end
end
setupMotors()

-- ============================================================
-- MANGA CAPTIONS (uwu style)
-- ============================================================
local function mangaCaption(text, duration)
    if not root then return end
    local gui = Instance.new("BillboardGui")
    gui.Name = "Neko_Manga"
    gui.AlwaysOnTop = true
    gui.Size = UDim2.fromOffset(120, 60)
    gui.StudsOffsetWorldSpace = Vector3.new(rng:NextNumber(-2,2), 4, rng:NextNumber(-2,2))
    gui.Parent = root

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = MANGA_BG
    frame.BorderSizePixel = 3
    frame.Size = UDim2.fromScale(1, 1)
    frame.Parent = gui
    Instance.new("UIStroke", frame).Thickness = 2

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBlack
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.Text = text
    lbl.TextColor3 = Color3.new(0, 0, 0)
    lbl.TextScaled = true
    lbl.Parent = frame

    TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Rotation = rng:NextNumber(-5, 5)}):Play()
    task.delay(duration or 1.2, function()
        TweenService:Create(lbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        TweenService:Create(frame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        Debris:AddItem(gui, 0.4)
    end)
end

-- ============================================================
-- TARGETING & LATCHING
-- ============================================================
local targetPlayer = nil
local isLatching = false

local function findNearestPlayer()
    local nearest = nil
    local dist = 50
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - root.Position).Magnitude
            if d < dist then
                dist = d
                nearest = p
            end
        end
    end
    return nearest
end

UserInputService.InputBegan:Connect(function(input, proc)
    if proc then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local mouse = player:GetMouse()
        local target = mouse.Target
        if target and target.Parent:FindFirstChildOfClass("Humanoid") then
            targetPlayer = Players:GetPlayerFromCharacter(target.Parent)
            mangaCaption("Target Found! :3", 1)
        end
    end
    if input.KeyCode == Enum.KeyCode.C then
        Anim.State = (Anim.State == "Kneel") and "Idle" or "Kneel"
        if Anim.State == "Kneel" then mangaCaption("uwu", 1) end
    end
end)

-- ============================================================
-- MAIN LOOP
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    if not root or not humanoid then return end
    Anim.Sine += dt * 10

    -- Auto-Follow & Latching Logic
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local tRoot = targetPlayer.Character.HumanoidRootPart
        local tHum  = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        local dist  = (tRoot.Position - root.Position).Magnitude
        
        if dist > LATCH_DISTANCE then
            humanoid:MoveTo(tRoot.Position)
            isLatching = false
            Anim.State = "Move"
        else
            isLatching = true
            Anim.State = "Latch"
            -- Ultra Smooth Latch: Stay in front of target and look at them
            local targetPos = tRoot.CFrame * CF(0, 0, -2.5).Position
            root.CFrame = Clerp(root.CFrame, CF(targetPos, Vector3.new(tRoot.Position.X, root.Position.Y, tRoot.Position.Z)), 0.12)
            if tHum and tHum.MoveDirection.Magnitude > 0.1 then
                Anim.Sine += dt * 5 -- Faster movement when target moves
            end
        end
    end

    -- State Detection
    local currentSpeed = humanoid.MoveDirection.Magnitude
    local velY = root.AssemblyLinearVelocity.Y
    local state = Anim.State
    
    if state ~= "Kneel" and not isLatching then
        if math.abs(velY) > 5 then
            state = "Jump"
        elseif currentSpeed > 0.8 then
            state = (humanoid.WalkSpeed > 20) and "Run" or "Walk"
        elseif currentSpeed > 0.1 then
            state = "Walk"
        else
            state = "Idle"
        end
    elseif isLatching then
        state = "Latch"
    end

    -- Procedural Poses (Ultra AAA R6)
    local s = Anim.Sine
    local T = {}
    
    if state == "Idle" then
        -- AAA Diz Çökerek Bekleme (Idle)
        T.root = CF(0, -1.9 + math.sin(s*0.4)*0.08, 0) * ANGLES(RAD(-10), 0, RAD(math.sin(s*0.2)*3))
        T.waist = ANGLES(RAD(15 + math.sin(s*0.4)*4), RAD(math.sin(s*0.2)*6), 0)
        T.rightShoulder = CF(0, 0, 0) * ANGLES(RAD(-25), 0, RAD(20 + math.sin(s*0.4)*2))
        T.leftShoulder = CF(0, 0, 0) * ANGLES(RAD(-25), 0, RAD(-20 - math.sin(s*0.4)*2))
        T.rightHip = CF(0, 0.6, -0.6) * ANGLES(RAD(95), 0, RAD(12))
        T.leftHip = CF(0, 0.6, -0.6) * ANGLES(RAD(95), 0, RAD(-12))
        
    elseif state == "Walk" then
        -- Dört Ayak Üzerinde Yürüyüş (Quadrupedal Walk)
        local moveS = s * 1.4
        T.root = CF(0, -1.6 + math.abs(math.sin(moveS))*0.2, 0) * ANGLES(RAD(20), 0, RAD(math.sin(moveS)*5))
        T.waist = ANGLES(RAD(-12), RAD(-math.sin(moveS)*8), 0)
        -- Ön Ayaklar (Kollar)
        T.rightShoulder = CF(0, 0.2, -0.2) * ANGLES(RAD(80 + math.sin(moveS)*50), 0, RAD(10))
        T.leftShoulder = CF(0, 0.2, -0.2) * ANGLES(RAD(80 - math.sin(moveS)*50), 0, RAD(-10))
        -- Arka Ayaklar (Bacaklar)
        T.rightHip = CF(0, 0.5, -0.4) * ANGLES(RAD(90 - math.sin(moveS)*40), 0, RAD(8))
        T.leftHip = CF(0, 0.5, -0.4) * ANGLES(RAD(90 + math.sin(moveS)*40), 0, RAD(-8))
        if rng:NextNumber() < 0.015 then mangaCaption("mew~", 0.8) end

    elseif state == "Run" then
        -- Dört Ayak Üzerinde Hızlı Koşu (Quadrupedal Run) - Daha Dinamik
        local runS = s * 2.5
        T.root = CF(0, -1.9 + math.abs(math.sin(runS))*0.4, 0) * ANGLES(RAD(40), 0, RAD(math.sin(runS)*10))
        T.waist = ANGLES(RAD(-25), RAD(-math.sin(runS)*15), 0)
        -- Ön Ayaklar (Kollar)
        T.rightShoulder = CF(0, 0.4, -0.4) * ANGLES(RAD(100 + math.sin(runS)*90), 0, RAD(20))
        T.leftShoulder = CF(0, 0.4, -0.4) * ANGLES(RAD(100 - math.sin(runS)*90), 0, RAD(-20))
        -- Arka Ayaklar (Bacaklar)
        T.rightHip = CF(0, 0.7, -0.6) * ANGLES(RAD(110 - math.sin(runS)*70), 0, RAD(15))
        T.leftHip = CF(0, 0.7, -0.6) * ANGLES(RAD(110 + math.sin(runS)*70), 0, RAD(-15))
        if rng:NextNumber() < 0.05 then mangaCaption("NYAA!", 0.5) end

    elseif state == "Jump" then
        -- Dört Ayak Üzerinde Zıplama Pozu (Gerilmiş Kedi) - Daha Esnek
        T.root = CF(0, 0.5, 0) * ANGLES(RAD(-25), 0, 0)
        T.waist = ANGLES(RAD(15), 0, 0)
        T.rightShoulder = CF(0, 0, 0) * ANGLES(RAD(-50), 0, RAD(25))
        T.leftShoulder = CF(0, 0, 0) * ANGLES(RAD(-50), 0, RAD(-25))
        T.rightHip = CF(0, 0, 0) * ANGLES(RAD(30), 0, RAD(15))
        T.leftHip = CF(0, 0, 0) * ANGLES(RAD(30), 0, RAD(-15))

    elseif state == "Kneel" then
        -- Diz Çökme (Yere Oturma)
        T.root = CF(0, -1.95 + math.sin(s*0.3)*0.05, 0) * ANGLES(RAD(-15), 0, 0)
        T.waist = ANGLES(RAD(20 + math.sin(s*0.3)*3), 0, 0)
        T.rightShoulder = CF(0, 0, 0) * ANGLES(RAD(-30), 0, RAD(25))
        T.leftShoulder = CF(0, 0, 0) * ANGLES(RAD(-30), 0, RAD(-25))
        T.rightHip = CF(0, 0.6, -0.6) * ANGLES(RAD(95), 0, RAD(15))
        T.leftHip = CF(0, 0.6, -0.6) * ANGLES(RAD(95), 0, RAD(-15))
        
    elseif state == "Latch" then
        -- Yapışma (Kucaklama / Sarılma)
        T.root = CF(0, -0.5 + math.sin(s*0.8)*0.1, 0) * ANGLES(RAD(5), 0, RAD(math.sin(s*0.4)*8))
        T.waist = ANGLES(RAD(-5), RAD(math.sin(s*0.4)*15), 0)
        T.rightShoulder = CF(0, 0, 0) * ANGLES(RAD(160), RAD(-20), RAD(-15))
        T.leftShoulder = CF(0, 0, 0) * ANGLES(RAD(160), RAD(20), RAD(15))
        T.rightHip = CF(0, 0, 0) * ANGLES(RAD(15), 0, RAD(5))
        T.leftHip = CF(0, 0, 0) * ANGLES(RAD(15), 0, RAD(-5))
        if rng:NextNumber() < 0.02 then mangaCaption("purr~", 1) end
    end

    -- Apply Poses
    for k, motor in pairs(Anim.Motors) do
        if motor and Anim.BaseC0[k] then
            motor.C0 = motor.C0:Lerp(Anim.BaseC0[k] * (T[k] or CF(0,0,0)), 0.18) -- Daha akıcı geçişler
        end
    end
end)

