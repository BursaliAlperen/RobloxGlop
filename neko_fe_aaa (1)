    createToggle("Theme: Pink", 60, function() ACCENT_COLOR = THEMES.Pink; stroke.Color = ACCENT_COLOR; openBtn.TextColor3 = ACCENT_COLOR; mangaCaption("Theme: Pink!", 1) end)
    createToggle("Theme: Purple", 105, function() ACCENT_COLOR = THEMES.Purple; stroke.Color = ACCENT_COLOR; openBtn.TextColor3 = ACCENT_COLOR; mangaCaption("Theme: Purple!", 1) end)
