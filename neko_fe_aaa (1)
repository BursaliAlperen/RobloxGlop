        isOpen = not isOpen
        local targetPos = isOpen and UDim2.new(1, -220, 0.5, -150) or UDim2.new(1, 220, 0.5, -150)
        TweenService:Create(panel, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {Position = targetPos}):Play()
