local function playBodyAnimation(style, duration)
    local stateMap = {
        kyoka   = "Mock",
        coffin  = "Kurohitsugi",
        raikoho = "Raikoho",
        shunpo  = "Shunpo",
        reiatsu = "Reiatsu",
        kyokaOrbit = "KyokaOrbit",
        kyokaSlash = "KyokaSlash",
    }
    AnimController:SetState(stateMap[style] or style or "Idle", duration or 0.8)
    local id = ANIMS[style]
    if not id or not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
                  or humanoid:WaitForChild("Animator", 2)
    if AnimController.Track then
        pcall(function() AnimController.Track:Stop(0.08) end)
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://"..id
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok then anim:Destroy() return end
    track.Priority = Enum.AnimationPriority.Action4
    track:Play(0.12)
    AnimController.Track = track
    task.delay(duration or 0.8, function()
        pcall(function() track:Stop(0.16) end)
        anim:Destroy()
    end)
end

