end

local function aaaGroundCrack(pos, normal, count, color, duration)
    for i = 1, count do
        local angle = rng:NextNumber(0, math.pi * 2)
        local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(0.5, 3)
        local startPos = pos + offset
        local endPos = startPos + normal * rng:NextNumber(2, 6)
        task.delay(i * 0.02, function()
            beam(startPos, endPos, color, rng:NextNumber(0.05, 0.15), duration)
        end)
    end
end

local function aaaLensFlare(pos, color, lifetime, scale)
    scale = scale or 1
    local center = orb(pos, 0.5 * scale, color or WHITE, lifetime or 0.45)
    center.Transparency = 0.18
    for i = 1, 6 do
        local angle = (math.pi * 2 / 6) * i
        local a = pos + Vector3.new(math.cos(angle), rng:NextNumber(-0.12, 0.12), math.sin(angle)) * (0.4 * scale)
        local b = pos + Vector3.new(math.cos(angle), rng:NextNumber(-0.12, 0.12), math.sin(angle)) * (6.5 * scale)
        task.delay(i * 0.008, function()
            beam(a, b, i % 2 == 0 and (color or WHITE) or GOLD, 0.055 * scale, lifetime or 0.38)
        end)
    end
end

local function aaaAfterImageRibbon(duration, color)
    local start = os.clock()
    task.spawn(function()
        while os.clock() - start < duration do
            ghostClone(Vector3.zero, 0.32)
            local p = root.Position + Vector3.new(0, 1.6, 0)
            aaaLensFlare(p, color or ACCENT, 0.22, 0.75)
            task.wait(0.055)
        end
    end)
end

local function aaaSpiralBloom(center, radius, colorA, colorB, lifetime)
    local steps = 18
    for i = 1, steps do
        task.delay(i * 0.012, function()
            local t = i / steps
            local a = t * math.pi * 4
            local p = center + Vector3.new(math.cos(a) * radius * t, math.sin(t * math.pi) * 3.2, math.sin(a) * radius * t)
            orb(p, 0.22 + t * 0.35, i % 2 == 0 and colorA or colorB, lifetime or 0.48)
            if i > 1 then
                local prevT = (i - 1) / steps
                local pa = prevT * math.pi * 4
                local prev = center + Vector3.new(math.cos(pa) * radius * prevT, math.sin(prevT * math.pi) * 3.2, math.sin(pa) * radius * prevT)
                beam(prev, p, i % 2 == 0 and colorA or colorB, 0.055, lifetime or 0.42)
            end
        end)
    end
end

