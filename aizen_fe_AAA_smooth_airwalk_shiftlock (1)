                            model:FindFirstChild("HumanoidRootPart")
                         or model:FindFirstChild("Torso")
                         or model:FindFirstChild("UpperTorso"))
                        if eRoot and (eRoot.Position-center.Position).Magnitude <= 25 then -- Daha geniş etki alanı
                            markAndFlingTarget(model, center.Position, 300) -- Çok daha güçlü fling
                            aaaGroundCrack(eRoot.Position, Vector3.new(0,1,0), 8, WHITE, 0.5) -- Yer çatlağı
                            aaaShockwave(eRoot.Position, WHITE, 10, 0.5) -- Fırlatma anında şok dalgası
