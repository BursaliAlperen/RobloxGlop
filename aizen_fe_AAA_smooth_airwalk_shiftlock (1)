        -- PHASE 3: Prison lock
        task.delay(0.95, function()
            aaaTimeFreeze(0.12) -- Daha uzun zaman dondurma
            aaaScreenShake(0.3, 0.6) -- Daha güçlü sarsıntı
            applyPostProcessing(18, 0, -1, 3.0) -- Daha yüksek bloom
            aaaDynamicLight(center.Position, DARK, 30, 70, 3.0) -- Daha güçlü dinamik ışık
