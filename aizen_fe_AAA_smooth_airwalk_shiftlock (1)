function AnimController:ApplyPose(targets, alpha)
    for k, motor in pairs(self.Motors) do
        if motor and self.BaseC0[k] then
            local offset = targets[k] or CFrame.new()
            motor.C0 = Clerp(motor.C0, self.BaseC0[k] * offset, alpha)
        end
    end
end

function AnimController:Update(dt)
    if not character or not root or not humanoid or humanoid.Health <= 0 then return end
    self.Sine += dt * 8
    local locked = self.StateEndsAt > os.clock()
    if not locked then self.State = self:AutoState() end

    -- airwalk physics: joystick / mobile thumbstick / default MoveDirection driven, with smooth acceleration.
    if self.State == "Airwalk" then
        local cam   = workspace.CurrentCamera
        local look  = cam and cam.CFrame.LookVector or root.CFrame.LookVector
        local right = cam and cam.CFrame.RightVector or root.CFrame.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatLook.Magnitude > 0.05 then flatLook = flatLook.Unit else flatLook = root.CFrame.LookVector end
        if flatRight.Magnitude > 0.05 then flatRight = flatRight.Unit else flatRight = root.CFrame.RightVector end

        local mi = humanoid and humanoid.MoveDirection or Vector3.zero
        local joystickMove = Vector3.zero
        if mi.Magnitude > 0.05 then
            -- Roblox joystick already writes into Humanoid.MoveDirection, so this stays mobile-friendly.
            joystickMove = Vector3.new(mi.X, 0, mi.Z)
        end
        local keyMove = (flatLook * airwalkDirection.Z) + (flatRight * airwalkDirection.X)
        local move = joystickMove + keyMove
        if move.Magnitude > 1 then move = move.Unit end

        local hover = Vector3.new(0, math.sin(os.clock()*3.1)*1.15, 0)
        local targetVelocity = move * AIRWALK_SPEED + hover
        airwalkVelocity = airwalkVelocity:Lerp(targetVelocity, AIRWALK_ACCEL_ALPHA)
        root.AssemblyLinearVelocity = airwalkVelocity

        local face = move.Magnitude > 0.05 and move or flatLook
        if face.Magnitude > 0.05 then
            root.CFrame = root.CFrame:Lerp(CFrame.new(root.Position, root.Position + face.Unit), 0.14)
        end
    elseif self.State == "Kurohitsugi" or self.State == "Reiatsu" or self.State == "Hover" then
        root.AssemblyLinearVelocity = Vector3.new(0, math.sin(os.clock()*3)*1.5, 0)
    else
        airwalkVelocity = airwalkVelocity:Lerp(Vector3.zero, 0.22)
    end

    if not locked and self.State == "Move" then return end
    local alpha = locked and 0.28 or 0.12
    local targets = self:TargetPose(self.State)
    if targets then self:ApplyPose(targets, alpha) end
end

