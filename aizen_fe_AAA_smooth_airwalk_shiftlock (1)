        local shard = makePart("Shard",
            Vector3.new(rng:NextNumber(0.04,0.12),rng:NextNumber(0.5,1.4),rng:NextNumber(0.02,0.06)),
            CF(origin), WHITE, Enum.Material.Glass, 0.18)
        local tangent = Vector3.new(rng:NextNumber(-1,1),rng:NextNumber(-0.25,1),rng:NextNumber(-1,1))
        if tangent.Magnitude < 0.1 then tangent = Vector3.new(0,1,0) end
        local vel = (normal*rng:NextNumber(3,9))+(tangent.Unit*rng:NextNumber(5,14))
        shard.CFrame = CF(origin, origin+vel)*ANGLES(rng:NextNumber(-3,3),rng:NextNumber(-3,3),rng:NextNumber(-3,3))
        tween(shard, 0.44, Enum.EasingStyle.Quart, Enum.EasingDirection.Out,
            {CFrame=shard.CFrame+vel, Transparency=1})
        Debris:AddItem(shard, 0.5)
