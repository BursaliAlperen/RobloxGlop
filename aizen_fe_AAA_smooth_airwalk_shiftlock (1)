        beam(s0+side, s1+side*2, i%2==0 and WHITE or LIGHTNING, 0.1, 0.6) -- Daha kalın beam
    end

    task.delay(0.3, function() -- Biraz daha gecikmeli patlama
        aaaTimeFreeze(0.1) -- Patlama anında zaman dondurma
        aaaScreenShake(0.4, 0.6) -- Güçlü sarsıntı
        aaaDynamicLight(s1, LIGHTNING, 50, 100, 1.0) -- Hedefte dinamik ışık
        
        beam(s0, s1, LIGHTNING, 8.0, 0.6) -- Çok daha kalın ana beam
        beam(s0, s1, Color3.new(1,1,1), 3.0, 0.5)
        aaaShockwave(s0, LIGHTNING, 15, 0.5) -- Ateşleme şok dalgası

        for i = 1, 40 do -- Çok daha fazla elektrik dalı
            local jit = Vector3.new(rng:NextNumber(-15,15),rng:NextNumber(-15,15),rng:NextNumber(-15,15))
            task.delay(i*0.01, function()
                beam(s0, s1+jit, LIGHTNING, 0.3, 0.4)
            end)
        end
        
        ring(CF(s1)*ANGLES(RAD(90),0,0), 20, LIGHTNING, 0.8, 0.2) -- Hedefte dev ring
        aaaShockwave(s1, LIGHTNING, 25, 0.8) -- Hedefte şok dalgası
        aaaGroundCrack(s1 - Vector3.new(0, 2, 0), Vector3.new(0,1,0), 12, LIGHTNING, 0.6) -- Hedefte yer çatlağı

        for i = 1, 15 do
            task.delay(i*0.015, function()
