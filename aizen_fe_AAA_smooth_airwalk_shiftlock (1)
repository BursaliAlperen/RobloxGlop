            -- PHASE 4: Detonation
            task.delay(1.0, function()
                aaaTimeFreeze(0.2) -- Daha uzun zaman dondurma
                aaaScreenShake(0.5, 0.8) -- Çok güçlü sarsıntı
                aaaDynamicLight(center.Position, GOLD, 80, 150, 1.5) -- Çok güçlü dinamik ışık
                
                orb(center.Position+Vector3.new(0,12,0), 12.0, Color3.fromRGB(52,17,91), 1.2) -- Çok büyük ve yoğun orb
                blackCoffinSpikes(center, 80) -- Daha fazla spike
                distortionBarrier(2.0, 40, 15) -- Daha büyük distorsiyon
                cameraPulse(0.4, 1.5) -- Daha güçlü pulse

                task.delay(0.75, function()
                    giantPurpleExplosion(center.Position+Vector3.new(0,12,0))
                    orb(center.Position+Vector3.new(0,12,0), 25, ACCENT, 2.0) -- Dev orb
                    ring(center*CF(0,12,0)*ANGLES(RAD(90),0,0), 40, WHITE, 1.5, 0.3) -- Dev ring
