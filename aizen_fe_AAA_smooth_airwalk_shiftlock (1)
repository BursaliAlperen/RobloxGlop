                    end)

                    -- PHASE 6: Pillars collapse
                    task.delay(0.65, function()
                        aaaScreenShake(0.15, 0.3) -- Hafif sarsıntı
                        aaaDynamicLight(center.Position, DARK, 10, 30, 0.5) -- Dinamik ışık
