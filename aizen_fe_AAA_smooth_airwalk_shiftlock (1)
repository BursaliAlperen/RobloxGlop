local function shunpo()
    cinematicCaption("SHUNPO", "A step outside perception.", 1.2) -- Daha uzun caption
    sideMangaCaption("Too slow.", 1.5)
    playBodyAnimation("shunpo", 1.0) -- Daha uzun animasyon
    aaaScreenShake(0.15, 0.5) -- Başlangıçta kamera sarsıntısı
    aaaDynamicLight(root.Position, WHITE, 10, 25, 0.8) -- Dinamik ışık
    ghostClone(Vector3.zero, 0.8) -- Daha uzun ömürlü klon
    distortionBarrier(0.5, 12, 3) -- Daha güçlü distorsiyon
    aaaShockwave(root.Position, WHITE, 6, 0.4) -- Başlangıç şok dalgası

    local startCF = root.CFrame
    local targetModel, targetRoot = findFrontTarget(60, 0.25) -- Daha geniş arama
    local destCF = targetRoot
        and CF((targetRoot.CFrame*CF(0,0,6.0)).Position, targetRoot.Position) -- Daha geriye teleport
        or  (startCF + startCF.LookVector*60) -- Daha uzun mesafe

    -- Speed lines before
    speedLines(startCF.Position+Vector3.new(0,2,0), startCF.LookVector, 50, 0.4) -- Daha yoğun ve uzun hız çizgileri
    orb(startCF.Position+Vector3.new(0,2,0), 2.0, WHITE, 0.3) -- Daha büyük flash
    ring(CF(startCF.Position), 4.0, WHITE, 0.4, 0.1) -- Başlangıçta ring
    aaaTimeFreeze(0.05) -- Teleport öncesi kısa zaman dondurma

    -- Afterimage rings along path
    for i = 1, 20 do -- Daha fazla ring
        local cf = startCF:Lerp(destCF, i/20)
        task.delay(i*0.01, function()
            ring(cf*ANGLES(RAD(90),0,0), 3.5+i*0.5, ACCENT, 0.4, 0.08) -- Daha büyük ve belirgin ringler
            petalBurst(cf.Position+Vector3.new(0,2,0), 8, GOLD, 0.4) -- Daha yoğun petal burst
        end)
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    root.CFrame = destCF
    aaaCinematicCamera(CF(destCF.Position + Vector3.new(0, 5, 10), destCF.Position), 0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) -- Sinematik kamera geçişi

    speedLines(root.Position+Vector3.new(0,2,0), root.CFrame.LookVector, 50, 0.4) -- Daha yoğun ve uzun hız çizgileri
    distortionBarrier(0.5, 12, 3) -- Daha güçlü distorsiyon
    aaaAfterImageRibbon(0.5, WHITE) -- Daha uzun afterimage
    aaaLensFlare(root.Position+Vector3.new(0,2,0), WHITE, 0.5, 1.5) -- Daha büyük lens flare
    orb(root.Position+Vector3.new(0,2,0), 2.0, WHITE, 0.3) -- Daha büyük flash
    glassShatter(root.Position+Vector3.new(0,2,0), -root.CFrame.LookVector, 30) -- Daha fazla cam kırığı
    aaaShockwave(root.Position, WHITE, 8, 0.5) -- Bitiş şok dalgası

    if targetModel then
        collapseTarget(targetModel, 1.5) -- Daha uzun collapse
        markAndFlingTarget(targetModel, root.Position, 100) -- Daha güçlü fling
        aaaScreenShake(0.2, 0.4) -- Vuruş sarsıntısı
        aaaGroundCrack(targetModel.HumanoidRootPart.Position, Vector3.new(0,1,0), 5, WHITE, 0.3) -- Yer çatlağı
    end
    task.delay(0.1, function()
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Running) end
    end)
end

