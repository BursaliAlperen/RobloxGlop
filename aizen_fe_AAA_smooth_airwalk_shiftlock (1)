local function aaaTimeFreeze(duration)
    local oldTimeScale = game.Workspace.DistributedGameTime
    game.Workspace.DistributedGameTime = 0.01 -- Neredeyse durdur
    task.delay(duration, function()
        game.Workspace.DistributedGameTime = oldTimeScale -- Geri yükle
