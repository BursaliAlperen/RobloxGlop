                    aaaGroundCrack(center.Position - Vector3.new(0, 0.5, 0), Vector3.new(0,1,0), 20, GOLD, 0.8) -- Yer çatlağı

                    -- 20 radial rays
                    for i = 1, 20 do -- Daha fazla ışın
                        local a = math.pi*2*i/20
                        beam(center.Position+Vector3.new(0,12,0),
                             (center*CF(math.cos(a)*40,15,math.sin(a)*40)).Position,
                             i%2==0 and WHITE or ACCENT, 0.2, 0.8) -- Daha kalın ve uzun ışınlar
                    end

                    -- Fling all in range
