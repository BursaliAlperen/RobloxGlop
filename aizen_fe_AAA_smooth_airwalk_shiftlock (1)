local function createAirwalkControls()
    -- Kullanıcı isteği: airwalk için ekranda buton/UI görünmesin.
    -- Hareket Roblox'un varsayılan joystick / thumbstick MoveDirection sistemiyle çalışır.
    return nil
end

local airwalkGui = createAirwalkControls()

local function setAirwalk(enabled)
    airwalkActive   = enabled
    airwalkDirection= Vector3.zero
    airwalkVerticalMode = 0
    if airwalkGui then airwalkGui.Enabled = enabled end
    if enabled then
        AnimController:SetState("Airwalk")
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        airwalkVelocity = root and root.AssemblyLinearVelocity or Vector3.zero
        sideMangaCaption("Airwalk\nenabled", 0.75)
        distortionBarrier(0.45, 10, 3)
        aaaLensFlare(root.Position + Vector3.new(0, 2, 0), ACCENT, 0.35, 0.9)
    else
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        airwalkDirection       = Vector3.zero
        airwalkVelocity        = Vector3.zero
        if root then root.AssemblyLinearVelocity = Vector3.zero end
        AnimController:SetState("Idle")
        sideMangaCaption("Airwalk\noff", 0.55)
    end
end

local function installAirwalkControls()
    UserInputService.JumpRequest:Connect(function()
        local now = os.clock()
        if now - lastJumpRequest < AIRWALK_DOUBLE_JUMP_WINDOW then
            setAirwalk(not airwalkActive)
            lastJumpRequest = 0
            return
        end
        lastJumpRequest = now
    end)

    -- PC desteği korunur; mobilde joystick zaten Humanoid.MoveDirection üzerinden çalışır.
    UserInputService.InputBegan:Connect(function(inp, proc)
        if proc or not airwalkActive then return end
        if inp.KeyCode == Enum.KeyCode.W then airwalkDirection += Vector3.new(0,0,1)
        elseif inp.KeyCode == Enum.KeyCode.S then airwalkDirection += Vector3.new(0,0,-1)
        elseif inp.KeyCode == Enum.KeyCode.A then airwalkDirection += Vector3.new(-1,0,0)
        elseif inp.KeyCode == Enum.KeyCode.D then airwalkDirection += Vector3.new(1,0,0)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if not airwalkActive then return end
        if inp.KeyCode == Enum.KeyCode.W then airwalkDirection -= Vector3.new(0,0,1)
        elseif inp.KeyCode == Enum.KeyCode.S then airwalkDirection -= Vector3.new(0,0,-1)
        elseif inp.KeyCode == Enum.KeyCode.A then airwalkDirection -= Vector3.new(-1,0,0)
        elseif inp.KeyCode == Enum.KeyCode.D then airwalkDirection -= Vector3.new(1,0,0)
        end
    end)
end

