local function createIntroGui(onComplete)
    local gui = Instance.new("ScreenGui")
    gui.Name="Aizen_Loader"; gui.IgnoreGuiInset=true; gui.ResetOnSpawn=false; gui.Parent=playerGui

    local shade = Instance.new("Frame")
    shade.BackgroundColor3=Color3.fromRGB(3,1,10); shade.BackgroundTransparency=0.06
    shade.BorderSizePixel=0; shade.Size=UDim2.fromScale(1,1); shade.Parent=gui

    local card = Instance.new("Frame")
    card.AnchorPoint=Vector2.new(0.5,0.5); card.BackgroundColor3=Color3.fromRGB(13,8,26)
    card.BorderSizePixel=0; card.Position=UDim2.fromScale(0.5,0.5)
    card.Size=UDim2.fromOffset(520,275); card.Parent=shade
    Instance.new("UICorner",card).CornerRadius=UDim.new(0,18)
    local sk=Instance.new("UIStroke"); sk.Color=ACCENT; sk.Thickness=2; sk.Transparency=0.15; sk.Parent=card

    local titleLbl=Instance.new("TextLabel"); titleLbl.BackgroundTransparency=1
    titleLbl.Font=Enum.Font.GothamBlack; titleLbl.Position=UDim2.fromOffset(28,24)
    titleLbl.Size=UDim2.new(1,-56,0,44); titleLbl.Text="Aizen FE"
    titleLbl.TextColor3=WHITE; titleLbl.TextScaled=true
    titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.Parent=card

    local subLbl=Instance.new("TextLabel"); subLbl.BackgroundTransparency=1
    subLbl.Font=Enum.Font.GothamSemibold; subLbl.Position=UDim2.fromOffset(30,78)
    subLbl.Size=UDim2.new(1,-60,0,32); subLbl.Text="script loading..."
    subLbl.TextColor3=GOLD; subLbl.TextScaled=true
    subLbl.TextXAlignment=Enum.TextXAlignment.Left; subLbl.Parent=card

    local barBack=Instance.new("Frame"); barBack.BackgroundColor3=Color3.fromRGB(32,22,54)
    barBack.BorderSizePixel=0; barBack.Position=UDim2.fromOffset(30,128)
    barBack.Size=UDim2.new(1,-60,0,12); barBack.Parent=card
    Instance.new("UICorner",barBack).CornerRadius=UDim.new(1,0)
    local bar=Instance.new("Frame"); bar.BackgroundColor3=ACCENT; bar.BorderSizePixel=0
    bar.Size=UDim2.fromScale(0,1); bar.Parent=barBack
    Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)

    tween(bar,1.25,Enum.EasingStyle.Quint,Enum.EasingDirection.Out,{Size=UDim2.fromScale(1,1)})
    task.delay(1.28,function()
        subLbl.Text="Ready."
        task.delay(0.4,function()
            tween(card,0.32,Enum.EasingStyle.Quint,Enum.EasingDirection.In,
                {Position=UDim2.fromScale(0.5,0.44),BackgroundTransparency=1})
            tween(shade,0.32,Enum.EasingStyle.Sine,Enum.EasingDirection.In,{BackgroundTransparency=1})
            Debris:AddItem(gui,0.42)
            onComplete()
        end)
    end)
end

-- ============================================================
-- KEY GATE — wrong key = rejected, correct = proceed
-- ============================================================
local function createKeyGate(onUnlock)
    local gui=Instance.new("ScreenGui"); gui.Name="Aizen_KeyGate"
    gui.IgnoreGuiInset=true; gui.ResetOnSpawn=false; gui.Parent=playerGui

    local shade=Instance.new("Frame"); shade.BackgroundColor3=Color3.fromRGB(3,1,10)
    shade.BackgroundTransparency=0.05; shade.BorderSizePixel=0
    shade.Size=UDim2.fromScale(1,1); shade.Parent=gui

    local card=Instance.new("Frame"); card.AnchorPoint=Vector2.new(0.5,0.5)
    card.Position=UDim2.fromScale(0.5,0.5); card.Size=UDim2.fromOffset(520,295)
    card.BackgroundColor3=Color3.fromRGB(13,8,26); card.BorderSizePixel=0; card.Parent=shade
    Instance.new("UICorner",card).CornerRadius=UDim.new(0,18)
    local sk=Instance.new("UIStroke"); sk.Color=ACCENT; sk.Thickness=2; sk.Parent=card

    local function lbl(parent, pos, size, text, color, font)
        local l=Instance.new("TextLabel"); l.BackgroundTransparency=1
        l.Position=pos; l.Size=size; l.Text=text; l.TextColor3=color or WHITE
        l.Font=font or Enum.Font.GothamSemibold; l.TextScaled=true; l.Parent=parent
        return l
    end

    lbl(card, UDim2.fromOffset(24,18), UDim2.new(1,-48,0,42),
        "AIZEN FE — ACCESS KEY", WHITE, Enum.Font.GothamBlack)
    lbl(card, UDim2.fromOffset(28,64), UDim2.new(1,-56,0,38),
        "Open the key page and enter the exact 6-character code. Route locked 10 min.",
        GOLD, Enum.Font.GothamSemibold)

    local box=Instance.new("TextBox"); box.PlaceholderText="ENTER KEY FROM YOUR ROUTE PAGE"
    box.Text=""; box.ClearTextOnFocus=false; box.Position=UDim2.fromOffset(34,118)
    box.Size=UDim2.new(1,-68,0,44); box.Font=Enum.Font.GothamBlack; box.TextScaled=true
    box.TextColor3=WHITE; box.BackgroundColor3=Color3.fromRGB(25,16,42); box.Parent=card
    Instance.new("UICorner",box).CornerRadius=UDim.new(0,10)

    local function makeBtn(text, posX, callback)
        local b=Instance.new("TextButton"); b.Text=text
        b.Position=UDim2.fromOffset(posX,178); b.Size=UDim2.new(0.45,-24,0,42)
        b.Font=Enum.Font.GothamBlack; b.TextScaled=true; b.TextColor3=WHITE
        b.BackgroundColor3=ACCENT; b.Parent=card
        Instance.new("UICorner",b).CornerRadius=UDim.new(0,10)
        b.MouseButton1Click:Connect(callback)
        return b
    end

    local statusLbl = lbl(card, UDim2.fromOffset(28,228), UDim2.new(1,-56,0,56), "", WHITE)

    makeBtn("COPY KEY PAGE", 34, function()
        if setclipboard then setclipboard(KEY_WEBSITE) end
        statusLbl.Text = "Copied: "..KEY_WEBSITE
        statusLbl.TextColor3 = GOLD
    end)

    makeBtn("UNLOCK", 270, function()
        local raw = string.upper((box.Text or ""):gsub("%s+",""))
        local key = raw:gsub("^KEY%d+-","")
        if key == EXPECTED_KEY or raw == EXPECTED_PREFIX then
            gui:Destroy()
            onUnlock()
        else
            -- Wrong key: reject
            statusLbl.Text = "Rejected. Use only the key shown on your copied route."
            statusLbl.TextColor3 = RED_HIT
            tween(card, 0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, {Position=UDim2.fromScale(0.502,0.5)})
            task.delay(0.06, function()
                tween(card, 0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, {Position=UDim2.fromScale(0.498,0.5)})
                task.delay(0.06, function()
                    tween(card, 0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, {Position=UDim2.fromScale(0.5,0.5)})
                end)
            end)
        end
    end)
end

