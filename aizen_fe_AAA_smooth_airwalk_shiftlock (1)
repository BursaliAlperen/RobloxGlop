local function makePart(name, size, cf, color, material, transparency)
    local p = Instance.new("Part")
    p.Name              = name
    p.Anchored          = true
    p.CanCollide        = false
    p.CanTouch          = false
    p.CanQuery          = false
    p.CastShadow        = false
    p.Size              = size
    p.CFrame            = cf
    p.Color             = color
    p.Material          = material or Enum.Material.Neon
    p.Transparency      = transparency or 0
    p.Parent            = cleanupBin
    return p
end

local function cameraPulse(power, duration)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local start = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        local alpha = (os.clock()-start)/duration
        if alpha >= 1 then conn:Disconnect() return end
        local f = 1-alpha
        cam.CFrame = cam.CFrame * CF(
            rng:NextNumber(-power,power)*f,
            rng:NextNumber(-power,power)*f,
            rng:NextNumber(-power,power)*f
        )
    end)
end

local function applyPostProcessing(bloom, blur, saturation, duration)
    -- Blur tamamen kaldırıldı. VFX sinematik kalır; görüş bulanıklaşmaz.
    local oldBloom = ppSettings.Bloom.Intensity
    local oldSat   = ppSettings.Color.Saturation
    ppSettings.Blur.Enabled = false
    ppSettings.Blur.Size = 0

    tween(ppSettings.Bloom, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Intensity = bloom})
    tween(ppSettings.Color, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Saturation = saturation})

    task.delay(duration, function()
        ppSettings.Blur.Enabled = false
        ppSettings.Blur.Size = 0
        tween(ppSettings.Bloom, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Intensity = oldBloom})
        tween(ppSettings.Color, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Saturation = oldSat})
    end)
end

local function cinematicFocus(targetPos, offset, duration)
    cameraSequenceToken += 1
    local myToken = cameraSequenceToken
    local cam = workspace.CurrentCamera
    local startCF = cam.CFrame
    cam.CameraType = Enum.CameraType.Scriptable
    
    task.spawn(function()
        local start = os.clock()
        while os.clock()-start < duration and cameraSequenceToken == myToken do
            local t = math.clamp((os.clock()-start)/duration, 0, 1)
            local targetCF = CF(targetPos + offset, targetPos)
            cam.CFrame = startCF:Lerp(targetCF, TweenService:GetValue(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
            RunService.RenderStepped:Wait()
        end
        if cameraSequenceToken == myToken then
            cam.CameraType = Enum.CameraType.Custom
        end
    end)
end

local function aaaCinematicCamera(targetCF, duration, easingStyle, easingDirection)
    local cam = workspace.CurrentCamera
    if not cam then return end
    cameraSequenceToken += 1
    local myToken = cameraSequenceToken
    local startCF = cam.CFrame
    cam.CameraType = Enum.CameraType.Scriptable

    task.spawn(function()
        local start = os.clock()
        while os.clock()-start < duration and cameraSequenceToken == myToken do
            local t = math.clamp((os.clock()-start)/duration, 0, 1)
            cam.CFrame = startCF:Lerp(targetCF, TweenService:GetValue(t, easingStyle or Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out))
            RunService.RenderStepped:Wait()
        end
        if cameraSequenceToken == myToken then
            cam.CameraType = Enum.CameraType.Custom
        end
    end)
end

local function smoothLookAt(fromPos, lookPos, duration)
    local cam = workspace.CurrentCamera
    if not cam then return end
    cameraSequenceToken += 1
    local token = cameraSequenceToken
    cam.CameraType = Enum.CameraType.Scriptable
    task.spawn(function()
        local start = os.clock()
        while os.clock()-start < duration and token == cameraSequenceToken do
            local a = math.clamp((os.clock()-start)/duration,0,1)
            local e = a*a*(3-2*a)
            cam.CFrame = cam.CFrame:Lerp(CF(fromPos, lookPos), e)
            RunService.RenderStepped:Wait()
        end
        if token == cameraSequenceToken then
            cam.CameraType = Enum.CameraType.Custom
        end
    end)
end

