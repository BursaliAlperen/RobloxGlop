local function deathReset()
    humanoid.Died:Connect(function()
        airwalkActive   = false
        airwalkDirection= Vector3.zero
        airwalkVelocity = Vector3.zero
        if humanoid then humanoid.AutoRotate = true; humanoid.PlatformStand = false end
        cleanupBin:ClearAllChildren()
        AnimController:SetState("Idle")
        if shiftLockEnabled then
            setShiftLock(false)
        end
    end)
end

